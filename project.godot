; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FujianBusSimulator"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/version="0.1.0-mvp"

[input]

accelerate={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
brake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
steer_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
steer_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
toggle_camera={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67), Object(InputEventKey,"physical_keycode":81)]
}
handbrake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
gear_r={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
gear_n={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":78)]
}
horn={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":72)]
}
engine_toggle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
signal_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":44)]
}
signal_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":46)]
}

[physics]

3d/default_gravity=9.8
